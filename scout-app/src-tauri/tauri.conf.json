{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scout",
  "version": "0.1.0",
  "identifier": "com.obose.scout",
  "build": {
    "beforeDevCommand": "npm run prepare:browser-runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:browser-runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scout",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/scout-node"
    ],
    "resources": {
      "../node_modules/chrome-devtools-mcp/": "browser-runtime/chrome-devtools-mcp/",
      "browser-runtime/NODE-LICENSE": "browser-runtime/NODE-LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
