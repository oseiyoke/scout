{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "notification:default",
    "autostart:default",
    "allow-set-tray-badge",
    "allow-set-tray-error",
    "allow-show-main-window",
    "allow-open-chrome-setup",
    "allow-set-menu-bar-only",
    "allow-get-secret",
    "allow-set-secret",
    "allow-delete-secret",
    "allow-start-oauth-callback",
    "allow-cancel-oauth-callback",
    "allow-start-chrome-browser",
    "allow-call-chrome-browser-tool",
    "allow-stop-chrome-browser",
    "allow-chrome-browser-connected",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*" },
        { "url": "http://localhost:*" },
        { "url": "http://*.localhost:*" },
        { "url": "http://127.*:*" },
        { "url": "http://[\\:\\:1]:*" }
      ]
    }
  ]
}
